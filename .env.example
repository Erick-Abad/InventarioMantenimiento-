PORT=3000
NODE_ENV=development
DB_HOST=inventario-valvulas-bitacora-mec.c.aivencloud.com
DB_PORT=17913
DB_NAME=inventario_valvulas
DB_USER=avnadmin
DB_PASSWORD=REEMPLAZAR_EN_TU_PC
# Opcion recomendada para Render: pegar el contenido completo del certificado CA en esta variable.
DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Alternativa local: apunta a un archivo .pem en tu equipo.
DB_SSL_CA_PATH=./certs/ca.pem
JWT_SECRET=GENERAR_SECRETO_ALEATORIO_LARGO
# Solo para crear el primer administrador mediante npm run seed:admin:
INITIAL_ADMIN_NAME=Erick Abad Monserrate
INITIAL_ADMIN_BARCODE=0987654321
INITIAL_ADMIN_PASSWORD=COLOCAR_CONTRASENA_DE_PRUEBA_TEMPORAL
